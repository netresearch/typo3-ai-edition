{
    "name": "netresearch/typo3-ai-edition",
    "description": "TYPO3 AI Edition: installs the Netresearch AI extensions for TYPO3 in versions tested together.",
    "type": "metapackage",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "TYPO3",
        "TYPO3 CMS",
        "AI",
        "LLM",
        "distribution",
        "edition"
    ],
    "homepage": "https://github.com/netresearch/typo3-ai-edition",
    "authors": [
        {
            "name": "Netresearch DTT GmbH",
            "email": "info@netresearch.de",
            "homepage": "https://www.netresearch.de/",
            "role": "Manufacturer"
        }
    ],
    "support": {
        "issues": "https://github.com/netresearch/typo3-ai-edition/issues",
        "source": "https://github.com/netresearch/typo3-ai-edition",
        "security": "https://github.com/netresearch/typo3-ai-edition/security/policy"
    },
    "require": {
        "php": "^8.3",
        "typo3/cms-core": "^14.3",
        "netresearch/nr-landingpage": "~0.3.26",
        "netresearch/nr-llm": "~0.43.23",
        "netresearch/nr-mcp-agent": "~0.36.0",
        "netresearch/nr-repurpose": "~0.14.0",
        "netresearch/nr-vault": "~1.5.0",
        "netresearch/t3-cowriter": "~3.27.0"
    },
    "conflict": {
        "netresearch/nr-browser-ai": "<0.8.0 || >=0.9.0",
        "netresearch/nr-llm-compat": "<0.5.0 || >=0.6.0"
    },
    "suggest": {
        "netresearch/nr-browser-ai": "On-device assistant for the current page in Chrome's built-in AI (tested: ~0.8.0)",
        "netresearch/nr-llm-compat": "Routes the LLM calls of third-party AI extensions through nr-llm (tested: ~0.5.0)"
    }
}
